# ── Basis ────────────────────────────────────────────────────────────────────
# Öffentliche URL des Shops (für Links in E-Mails, Stripe-Redirects, Tracking)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | development
NODE_ENV=development

# ── Datenbank (PostgreSQL) ──────────────────────────────────────────────────
# Lokal:
DATABASE_URL=postgres://winterfeld:CHANGE_ME@localhost:5432/winterfeld_shop
# Serverless-Betrieb (Vercel o. ä.) hinter einem Transaction-Pooler, z. B. Supabase:
#   postgresql://postgres.<projekt-ref>:<passwort>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Pooler werden automatisch erkannt (Port 6543 / Host "pooler." / pgbouncer=true);
# vorbereitete Anweisungen werden dann abgeschaltet und die Verbindungszahl reduziert.

# ── Sessions & Auth ─────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX

# ── Stripe (ausschließlich serverseitig!) ───────────────────────────────────
STRIPE_SECRET_KEY=
# Signing-Secret des Webhook-Endpoints /api/webhooks/stripe (whsec_…)
STRIPE_WEBHOOK_SECRET=

# ── DHL Paket (Parcel DE Shipping API v2) ───────────────────────────────────
# https://developer.dhl.com → "Parcel DE Shipping (Post & Parcel Germany)"
DHL_PAKET_API_BASE=https://api-eu.dhl.com/parcel/de/shipping/v2
DHL_PAKET_API_KEY=
DHL_PAKET_USER=
DHL_PAKET_PASSWORD=
# Abrechnungsnummer (EKP + Verfahren + Teilnahme, 14-stellig)
DHL_PAKET_BILLING_NUMBER=

# ── DHL Express (MyDHL API) ─────────────────────────────────────────────────
# https://developer.dhl.com → "DHL Express - MyDHL API"
DHL_EXPRESS_API_BASE=https://express.api.dhl.com/mydhlapi
DHL_EXPRESS_API_KEY=
DHL_EXPRESS_API_SECRET=
DHL_EXPRESS_ACCOUNT_NUMBER=

# ── Absenderadresse für Versandlabels ───────────────────────────────────────
SHIP_FROM_NAME=Winterfeld Logistik
SHIP_FROM_STREET=Musterstraße
SHIP_FROM_HOUSE_NUMBER=1
SHIP_FROM_ZIP=12345
SHIP_FROM_CITY=Musterstadt
SHIP_FROM_COUNTRY=DE
SHIP_FROM_EMAIL=versand@example.de
SHIP_FROM_PHONE=+49000000000

# ── E-Mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Winterfeld Logistik <shop@example.de>"

# ── Uploads ─────────────────────────────────────────────────────────────────
# Ablage für Produktbilder (wird unter /uploads ausgeliefert)
UPLOADS_DIR=./public/uploads

# ── Steuern ─────────────────────────────────────────────────────────────────
# Standard-MwSt.-Satz in Prozent (Preise im Shop sind Bruttopreise)
DEFAULT_TAX_RATE=19
