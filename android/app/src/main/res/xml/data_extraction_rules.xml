<?xml version="1.0" encoding="utf-8"?>
<!--
  Nichts sichern oder auf ein neues Gerät übertragen: die Anmeldedaten sind mit
  einem Schlüssel verschlüsselt, der das Gerät nie verlässt. Käme die Datei
  ohne den Schlüssel zurück, könnte die App sie nicht mehr lesen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
