# ── Datenbank ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://winterfeld:CHANGE_ME@localhost:5432/winterfeld
# Mit "docker compose --profile lokale-db": Host ist der Dienstname "db".
#   postgresql+psycopg2://winterfeld:$POSTGRES_PASSWORD@db:5432/winterfeld
# Mit Supabase: die Zeichenkette aus dem Dashboard nehmen (Connect → Session
# pooler). Der direkte Host db.<ref>.supabase.co ist im kostenlosen Tarif nur
# über IPv6 erreichbar — der Pooler antwortet auch über IPv4.
# Nur mit --profile lokale-db nötig:
POSTGRES_PASSWORD=

# ── Sicherheit ───────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
# Produktionsmodus erzwingt sichere Defaults (kein Debug, strikte CORS)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8000

# ── Objekt-Storage ──────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=winterfeld-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1
# Öffentliche Basis-URL für Shopbilder (CDN o. ä.); leer = Backend liefert selbst aus
MEDIA_PUBLIC_BASE_URL=

# ── KI-Provider (nur serverseitig! Niemals im Android-Client) ───────────────
# Vision / LLM-Extraktion / Shoptexte
ANTHROPIC_API_KEY=
# claude-opus-5: beste Erkennung. claude-sonnet-5: guenstiger (etwa 40 % der
# Kosten), fuer Etiketten und Sprachnotizen meist ebenso gut.
ANTHROPIC_MODEL=claude-opus-5

# Speech-to-Text: beliebige Whisper-kompatible API (OpenAI, Groq, lokales whisper.cpp-Server, …)
STT_API_BASE=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Produkt-/Preisrecherche (HTTP-Suchprovider, z. B. SerpAPI-/Firecrawl-kompatibel)
PRICE_RESEARCH_API_BASE=
PRICE_RESEARCH_API_KEY=

# Optionale externe Freistellung (Hintergrund entfernen), z. B. selbst gehostetes rembg
BACKGROUND_REMOVAL_API_BASE=

# ── KI-Verhalten ────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.85
# Aufbewahrung der Audio-Rohdaten nach Transkription in Stunden (0 = sofort löschen, DSGVO-Default)
VOICE_RETENTION_HOURS=0

# ── Jobs ────────────────────────────────────────────────────────────────────
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
# Job-Worker im API-Prozess mitlaufen lassen (spart einen zweiten Dienst).
# Nur mit WEB_CONCURRENCY=1 sinnvoll; sonst als eigenen Dienst starten:
#   docker run … winterfeld-api worker
RUN_WORKER_IN_PROCESS=false

# ── Betrieb hinter einem Reverse Proxy (Server im Internet) ─────────────────
# Nur mit "docker compose --profile proxy". Caddy holt das TLS-Zertifikat
# selbst, sobald dieser Name auf den Server zeigt.
DOMAIN=

# ── Betrieb zu Hause oder im Betrieb hinter dem Router ──────────────────────
# Nur mit "docker compose --profile tunnel". Das Token kommt aus dem
# Cloudflare-Dashboard (Zero Trust -> Networks -> Tunnels -> Create a tunnel).
# Damit braucht der Router keinen offenen Port und das Zertifikat kommt von
# Cloudflare. MEDIA_PUBLIC_BASE_URL oben dann auf
#   https://<Ihr Name>/api/v1/media
# setzen, damit der Shop die Bilder laden kann.
TUNNEL_TOKEN=

# ── Container-Betrieb ───────────────────────────────────────────────────────
# Migrationen beim Start einspielen (wiederholbar – ist alles drin, passiert nichts).
RUN_MIGRATIONS=false
# Port und Anzahl der Uvicorn-Prozesse (Vorgabe 8000 / 1).
PORT=8000
WEB_CONCURRENCY=1
# Sekunden, die der Container beim Start auf die Datenbank wartet.
DB_WAIT_SECONDS=60

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=120
