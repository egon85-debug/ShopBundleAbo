# ── Datenbank ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://winterfeld:CHANGE_ME@localhost:5432/winterfeld
# Mit "docker compose --profile lokale-db": Host ist der Dienstname "db".
#   postgresql+psycopg2://winterfeld:$POSTGRES_PASSWORD@db:5432/winterfeld
# Mit Supabase: die Zeichenkette aus dem Dashboard nehmen (Connect → Session
# pooler). Der direkte Host db.<ref>.supabase.co ist im kostenlosen Tarif nur
# über IPv6 erreichbar — der Pooler antwortet auch über IPv4.
# Nur mit --profile lokale-db nötig:
POSTGRES_PASSWORD=
# Aufgaben über alle Firmen (Job-Warteschlange, Webhook-Zuordnung). In der
# Plattform eine eigene Datenbankrolle mit BYPASSRLS; die Rolle aus
# DATABASE_URL hat dieses Recht NICHT (Row Level Security, siehe
# deploy/datenbank-rechte.sql). Leer = gleiche Verbindung wie DATABASE_URL —
# reicht nur, wenn diese Rolle Superuser ist (heutige Einzelinstallation).
DATABASE_URL_PLATTFORM=

# ── Sicherheit ───────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
# Produktionsmodus erzwingt sichere Defaults (kein Debug, strikte CORS)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8000

# ── Objekt-Storage ──────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=winterfeld-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1
# Öffentliche Basis-URL für Shopbilder (CDN o. ä.); leer = Backend liefert selbst aus
MEDIA_PUBLIC_BASE_URL=

# ── KI-Provider (nur serverseitig! Niemals im Android-Client) ───────────────
# Vision / LLM-Extraktion / Shoptexte
ANTHROPIC_API_KEY=
# claude-sonnet-5: Standard, etwa 40 % der Kosten von claude-opus-5.
# claude-opus-5 liest schwierige Etiketten etwas besser, sprengt aber das
# Budget je Artikel (KI_BUDGET_JE_ARTIKEL_USD) schneller.
ANTHROPIC_MODEL=claude-sonnet-5
# Harte Obergrenze der KI-Kosten je Artikel in US-Dollar. Reicht das Rest-
# budget nicht mehr für einen Schritt, wird er übersprungen (sichtbar im Lager).
KI_BUDGET_JE_ARTIKEL_USD=0.35
# Denktiefe der KI (low | medium | high). Das Nachdenken wird wie Ausgabe
# berechnet; ohne Angabe denkt Sonnet 5 auf „high“. Für Ablesen, Auswerten und
# Texte reicht low, die Recherche mit Websuche bekommt medium.
KI_EFFORT=low
KI_EFFORT_RECHERCHE=medium
# Höchstens so viele Bilderkennungen je Artikel.
KI_MAX_ERKENNUNGEN=2
# Modell für Websuche/Recherche und für Shoptext/Spracheingabe (leer = ANTHROPIC_MODEL).
# Haiku kostet die Hälfte von Sonnet 5 und denkt nicht vorab.
KI_MODELL_RECHERCHE=claude-haiku-4-5
KI_MODELL_TEXT=claude-haiku-4-5
# Artikel mit EAN zuerst kostenlos in Open Food Facts & Co. nachschlagen.
PRODUKTDATENBANKEN=true
# true = Preisrecherche automatisch nach der Produktrecherche,
# false = nur per Knopf „Marktpreise aktualisieren“ im Lager-Web.
PREISRECHERCHE_AUTOMATISCH=false

# Speech-to-Text: beliebige Whisper-kompatible API (OpenAI, Groq, lokales whisper.cpp-Server, …)
STT_API_BASE=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Produkt-/Preisrecherche. Ohne eigene Recherche-API sucht Claude selbst im Netz
# (Websuche bei Anthropic, ca. 1 Cent je Suche; es reicht ANTHROPIC_API_KEY).
# RESEARCH_PROVIDER: auto | anthropic | http | off
RESEARCH_PROVIDER=auto
RESEARCH_MAX_SEARCHES=2
# Abgerufene Seiten auf so viele Tokens kürzen (größter Kostenblock der Recherche)
RESEARCH_MAX_FETCH_TOKENS=6000
# Eigener HTTP-Suchprovider (z. B. SerpAPI-/Firecrawl-kompatibel) — hat bei
# "auto" Vorrang, sobald gesetzt
PRICE_RESEARCH_API_BASE=
PRICE_RESEARCH_API_KEY=

# Hintergrund der Shopbilder entfernen: lokal auf dem Server (Modell im
# Docker-Image) oder ueber einen externen Dienst. auto | off
BACKGROUND_REMOVAL=auto
BACKGROUND_REMOVAL_API_BASE=

# Nach dem ersten Foto so lange warten, bis die Erkennung startet, damit
# Rueckseite, Typenschild und Barcode mit ausgewertet werden
RECOGNITION_DELAY_SECONDS=20

# ── KI-Verhalten ────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.85
# Aufbewahrung der Audio-Rohdaten nach Transkription in Stunden (0 = sofort löschen, DSGVO-Default)
VOICE_RETENTION_HOURS=0

# ── Jobs ────────────────────────────────────────────────────────────────────
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
# Job-Worker im API-Prozess mitlaufen lassen (spart einen zweiten Dienst).
# Nur mit WEB_CONCURRENCY=1 sinnvoll; sonst als eigenen Dienst starten:
#   docker run … winterfeld-api worker
RUN_WORKER_IN_PROCESS=false
# Faire Warteschlange: höchstens so viele Aufträge einer Firma gleichzeitig.
JOB_MAX_PARALLEL_JE_MANDANT=2

# ── Betrieb hinter einem Reverse Proxy (Server im Internet) ─────────────────
# Nur mit "docker compose --profile proxy". Caddy holt das TLS-Zertifikat
# selbst, sobald dieser Name auf den Server zeigt.
DOMAIN=

# ── Betrieb zu Hause oder im Betrieb hinter dem Router ──────────────────────
# Nur mit "docker compose --profile tunnel". Das Token kommt aus dem
# Cloudflare-Dashboard (Zero Trust -> Networks -> Tunnels -> Create a tunnel).
# Damit braucht der Router keinen offenen Port und das Zertifikat kommt von
# Cloudflare. MEDIA_PUBLIC_BASE_URL oben dann auf
#   https://<Ihr Name>/api/v1/media
# setzen, damit der Shop die Bilder laden kann.
TUNNEL_TOKEN=

# ── Container-Betrieb ───────────────────────────────────────────────────────
# Migrationen beim Start einspielen (wiederholbar – ist alles drin, passiert nichts).
RUN_MIGRATIONS=false
# Port und Anzahl der Uvicorn-Prozesse (Vorgabe 8000 / 1).
PORT=8000
WEB_CONCURRENCY=1
# Sekunden, die der Container beim Start auf die Datenbank wartet.
DB_WAIT_SECONDS=60

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=120

# ── Android-App vom eigenen Server (https://<Domain>/app) ────────────────────
# Nur noetig, solange das GitHub-Repository privat ist: ein fine-grained Token
# (github.com → Settings → Developer settings → Fine-grained tokens), nur fuer
# dieses eine Repository, Berechtigung "Contents: Read-only". Danach:
#   docker compose exec api python -m app.cli app-holen
GITHUB_TOKEN=

# ── eBay (Verkäuferschnittstelle) ───────────────────────────────────────────
# Schlüssel aus developer.ebay.com → My Account → Application Keys (Production).
# RUNAME: unter „User Tokens“ → „Get a Token from eBay via Your Application“ →
# „Add eBay Redirect URL“ anlegen; als „Your auth accepted URL“
#   https://<Domain>/api/v1/shop/ebay/rueckruf
# eintragen und den dort angezeigten RuName hier einsetzen. Diese Werte gehören
# nur in die .env auf dem Server – nie in den Quellcode oder die App.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
# production oder sandbox (eBay-Testsystem)
EBAY_UMGEBUNG=production
# Wie oft neue eBay-Verkäufe abgeholt werden (Minuten).
EBAY_BESTELLABRUF_MINUTEN=5
