# Von Ansible verwaltet (Rolle app). Enthält Geheimnisse: Modus 0600.
ENVIRONMENT=production
DOMAIN={{ app_domain }}
CORS_ORIGINS=https://{{ app_domain }}

# Anwendung: ohne BYPASSRLS (Row Level Security greift).
DATABASE_URL=postgresql+psycopg2://{{ db_rolle_app }}:{{ db_kennwort_app }}@{{ db_privat_ip }}:5432/{{ db_name }}
# Aufgaben über alle Firmen (Warteschlange, Webhooks): mit BYPASSRLS.
DATABASE_URL_PLATTFORM=postgresql+psycopg2://{{ db_rolle_plattform }}:{{ db_kennwort_plattform }}@{{ db_privat_ip }}:5432/{{ db_name }}
# Nur für den Migrationslauf (Dienst „migrate“): Eigentümer der Tabellen.
DATABASE_URL_EIGENTUEMER=postgresql+psycopg2://{{ db_rolle_eigentuemer }}:{{ db_kennwort_eigentuemer }}@{{ db_privat_ip }}:5432/{{ db_name }}

JWT_SECRET={{ geheim.jwt_secret }}
CREDENTIALS_KEY={{ geheim.credentials_key }}

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://{{ s3_endpunkt }}
S3_BUCKET={{ s3_bucket_medien }}
S3_REGION={{ s3_region }}
S3_ACCESS_KEY={{ geheim.s3_access_key }}
S3_SECRET_KEY={{ geheim.s3_secret_key }}

ANTHROPIC_API_KEY={{ geheim.anthropic_api_key }}

RUN_MIGRATIONS=false
RUN_WORKER_IN_PROCESS=false
